<%
const { contract, utils } = it;
const { formatDescription, require, _ } = utils;

const getValidationDecorator = (field) => {
  const type = field.value;
  if (type === 'string' || type.includes('string')) return '@IsString()';
  if (type === 'number' || type.includes('number')) return '@IsNumber()';
  if (type === 'boolean' || type.includes('boolean')) return '@IsBoolean()';
  if (field.isArray) return '@IsArray()';
  return null;
};

// Explicit swagger type. Without it, consumers that rebuild an OpenAPI spec
// by reflecting these precompiled classes (e.g. a BFF re-exposing types)
// lose the type on nullable fields: `number | null` reflects as Object.
const getSwaggerType = (field) => {
  if (field.isArray) return null;
  const base = field.value.replace(' | null', '');
  if (base === 'string') return "type: 'string'";
  if (base === 'number') return "type: 'number'";
  if (base === 'boolean') return "type: 'boolean'";
  if (/^[A-Z][A-Za-z0-9]*$/.test(base)) return 'type: () => ' + base;
  // String-literal enum unions: "A" | "B"
  if (/^"[^"]*"( \| "[^"]*")*$/.test(base)) {
    const values = base.split(' | ').map((v) => v.slice(1, -1));
    return "type: 'string', enum: " + JSON.stringify(values);
  }
  // Numeric-literal enum unions: 1 | 2
  if (/^-?\d+(\.\d+)?( \| -?\d+(\.\d+)?)*$/.test(base)) {
    const values = base.split(' | ').map(Number);
    return "type: 'number', enum: " + JSON.stringify(values);
  }
  return null;
};
%>
export class <%~ contract.name %> {
<% for (const field of contract.$content) { %>
<%~ includeFile('./object-field-jsdoc.ejs', { ...it, field }) %>
  <% if (field.isRequired) { %>@IsDefined()
  <% } else { %>@IsOptional()
  <% } %><% const validator = getValidationDecorator(field); %><% if (validator) { %><%~ validator %>
  <% } %><% const swaggerType = getSwaggerType(field); %>@ApiProperty({ required: <%~ field.isRequired ? 'true' : 'false' %><%~ field.isNullable ? ', nullable: true' : '' %><%~ swaggerType ? `, ${swaggerType}` : '' %> })
  <%~ field.name %><%~ field.isRequired ? '' : '?' %>: <%~ field.value %><%~ (field.isNullable && !field.value.includes('| null')) ? ' | null' : ''%>;

<% } %>}
